    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst rows = items.map(i => i.json);\n\n// Calculate totals\nconst closedRows = rows.filter(r => r['Status'] === 'Closed');\nconst totalRevenue = closedRows.reduce((sum, r) => sum + parseFloat(r['Revenue (USD)'] || 0), 0);\nconst totalUnits = closedRows.reduce((sum, r) => sum + parseInt(r['Units Sold'] || 0), 0);\n\n// Revenue per salesperson\nconst byPerson = {};\nclosedRows.forEach(r => {\n  const name = r['Salesperson'];\n  if (!byPerson[name]) byPerson[name] = 0;\n  byPerson[name] += parseFloat(r['Revenue (USD)'] || 0);\n});\n\n// Build leaderboard string\nconst leaderboard = Object.entries(byPerson)\n  .sort((a, b) => b[1] - a[1])\n  .map(([name, rev]) => `  ${name}: $${rev.toFixed(2)}`)\n  .join('\\n');\n\n// Build final report\nconst report = `📊 WEEKLY SALES REPORT\n━━━━━━━━━━━━━━━━━━━━\n✅ Closed Deals   : ${closedRows.length}\n📦 Total Units    : ${totalUnits}\n💰 Total Revenue  : $${totalRevenue.toFixed(2)}\n\n🏆 Top Performers:\n${leaderboard}\n\nGenerated: ${new Date().toDateString()}`;\n\nreturn [{ json: { report } }];"
      },
